{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.js",
      "src/**/*.css",
      "biome.json",
      "package.json",
      "tsconfig.json",
      "tsconfig.worker.json",
      "vite.config.js",
      "agent-bridge.mjs",
      "agent-mcp.mjs",
      "!!dist",
      "!!public",
      "!!node_modules",
      "!!package-lock.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": false
  }
}
