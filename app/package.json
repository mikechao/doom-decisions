{
  "name": "doom-decisions-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:impeccable": "vite --mode impeccable --host 127.0.0.1 --port 5173 --strictPort",
    "build": "node ../scripts/stage_web.mjs verify public && npm run typecheck && vite build && node ../scripts/stage_web.mjs verify dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.fixtures.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "npm run typecheck && node ../scripts/check_worker.mjs && npm test && biome check ."
  },
  "dependencies": {
    "@openrouter/sdk": "1.4.25",
    "@typesafe-ai/sdk": "0.7.0",
    "openai": "7.32.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
